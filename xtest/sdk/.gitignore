# .gitignore for the xtest/sdk directory

# All checked out projects with checkout-*.sh scripts.
*/src
*/dist

# go release installs in progress, or killed mid-build.
*/.staging

# The Maven repository java builds from `install local` install into, in place
# of ~/.m2/repository.
*/.m2

# Generated helper build .env files
*/*.env

# generated binaries
otdfctl-*
otdfctl
