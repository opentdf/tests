{
  "about": [
    "Expected per-SDK answers for test_tdf_validity.py (DSPX-5349). See spec/tdf-validity.md.",
    "A case's agreed answer lives in tdfvalidity_corpus.py. This file records only what differs from it, each with the ticket that explains it, and every SDK's answer to the undecided and unspecified cases.",
    "A cell is \"valid\", \"invalid\" or \"error\", or an object adding \"ticket\", \"layer\" (where the rejection lands, when not the case's layer) and \"note\".",
    "Any difference from this file fails the run. Refresh with: uv run python tdfvalidity.py test-results/tdf-validity*.json"
  ],
  "format": 1,
  "sdks": {
    "go": {
      "status": "seeded",
      "source": "otdfctl validate (DSPX-5350, opentdf/platform#4254), which reports sdk.IsValidTdf and its error. Seeded by running platform/sdk v0.35.0 IsValidTdf as a library over this corpus.",
      "reason_patterns": {
        "archive": "NewTDFReader",
        "manifest-missing": "Manifest failed",
        "manifest-json": "could not validate manifest",
        "manifest-schema": "manifest was not valid"
      }
    },
    "java": {
      "status": "pending",
      "source": "java cmdline validate (DSPX-5352) does not exist yet; java-sdk has only SDK.isTDF, which never parses the manifest. Seed from the first run: see spec/tdf-validity.md.",
      "ticket": "DSPX-5352"
    },
    "js": {
      "status": "seeded",
      "source": "@opentdf/ctl validate (DSPX-5351, opentdf/web-sdk#1119), which reports validateTdf. Seeded by running validateTdf from #1119 (d293e509, stacked on #1118, #1117 and #1104) as a library over this corpus; its verdicts match #1104 isValidTdf on every case.",
      "reason_patterns": {
        "archive": "central directory|local file header|compression method|compressed size",
        "manifest-missing": "CD manifest",
        "manifest-json": "not valid JSON",
        "manifest-schema": "lax schema|not a JSON object"
      }
    }
  },
